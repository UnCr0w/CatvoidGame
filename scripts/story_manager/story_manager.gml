function prologue(){
    create_dialogue([
    {
        name: "",
        msg: "BOOM!!!"
    },
    {
        name: "Solana",
        msg: "Urgh..."
    },
    {
        name: "Solana",
        msg: "My morning is ruined already..."
    }
    ])
}

function help_call(){
    create_dialogue([
        {
            name: "Toby",
            msg: "SOLANAAA, HELP ME!!!"
        },
        {
            name: "Solana",
            msg: "..."
        },
        {
            name: "Solana",
            msg: "Let's take a look outside..."
        }
    ])
}

function toby_scream(){
    create_dialogue([
        {
            name: "Toby",
            msg: "ARGHHHHH- help me..."
        },
        {
            name: "Solana",
            msg: "..."
        },
        {
            name: "Solana",
            msg: "I better hurry..."
        }
    ])
}

function kale_encounter(){
    create_dialogue([
        {
            name: "",
            msg: "What you were expecting to see first thing in the morning is definitely not this."
        },
        {
            name: "",
            msg: "This world truly is chaos wrapped in lies, but you couldn't care less"
        },
        {
            name: "",
            msg: "That's what you used to say..."
        },
        {
            name: "Solana",
            msg: "Toby... He's dead again..."
        },
        {
            name: "",
            msg: "Even after you and your friends graduated from the magic academy, these brats won't leave you alone."
        },
        {
            name: "",
            msg: "You know for sure that these brats won't listen to you if you ask them to go nicely..."
        },
        {
            name: "Solana",
            msg: "What is this behavior, Kale?"
        },
        {
            name: "Kale",
            msg: "Ah, this? His face sickens me. I want him dead, if only he could die forever"
        },
        {
            name: "Solana",
            msg: "Disgusting creatures like you don't deserve Life."
        },
        {
            name: "Kale",
            msg: "What are you going to do? Scratch me with those tiny paws?"
        },
        {
            name: "Solana",
            msg: "I will give you..."
        },
        {
            name: "Solana",
            msg: "A taste of Death."
        }
    ])
}