global.party = [];

function Character(_name ,_hp, _atk, _def, _acc, _revelation_cap, _card_list, _sprite_battle) constructor {
    name = _name;
    hp = _hp;
    atk = _atk
    def = _def;
    acc = _acc;
    revelation = _revelation_cap;
    card_list = _card_list;
    sprite_battle = _sprite_battle;
}
